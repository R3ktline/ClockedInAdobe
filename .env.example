# Copy to .env.local and fill in. Never commit .env.local.
# Share the real key via a password manager, not chat.
# Without DEEPSEEK_API_KEY the LLM is mocked and everything still runs.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Any OpenAI-compatible API works, e.g. https://openrouter.ai/api/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional
# BABEL_LLM=mock                 # force the mock even with a key (offline demo)
# BABEL_MIN_SLIDE_GAP_MS=20000   # pause between automatic slides
# BABEL_DIRECTOR_BUDGET_MS=6000  # Director time budget; raise for slow free models (e.g. via OpenRouter)
